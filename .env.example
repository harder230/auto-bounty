# OpenAI Configuration (Primary LLM)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Anthropic Claude (Fallback)
ANTHROPIC_API_KEY=sk-ant-your-claude-key-here

# Grok (Alternative)
GROK_API_KEY=your-grok-key-here

# GitHub Configuration
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_USERNAME=your-username

# Bounty Sources - Optional API Keys
GITCOIN_API_KEY=your-gitcoin-api-key
CODE4RENA_API_KEY=your-code4rena-api-key
DEWORK_API_KEY=your-dework-api-key

# Notification Settings
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Agent Settings
AGENT_MAX_BOUNTIES_PER_RUN=3
AGENT_MIN_REWARD_USD=100
AGENT_DIFFICULTY=easy,medium
ENABLE_AUTO_PR=true
ENABLE_NOTIFICATIONS=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=agent.log
